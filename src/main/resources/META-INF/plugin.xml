<idea-plugin>
    <id>com.lamali.cardloc</id>
    <name>Downfall Card Localization</name>
    <version>1.0.2</version>
    <vendor>Downfall</vendor>
    <description>Auto-opens a localization editor when editing card classes.</description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
                id="STS2 Localization"
                anchor="right"
                factoryClass="com.lamali.cardloc.idea.CardLocToolWindowFactory"/>

        <postStartupActivity
                implementation="com.lamali.cardloc.core.CardLocStartupActivity"/>
    </extensions>

    <projectListeners>
        <listener
                class="com.lamali.cardloc.core.CardFileListener"
                topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>

        <listener
                class="com.lamali.cardloc.core.CardLocConfigWatcher"
                topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
    </projectListeners>
</idea-plugin>